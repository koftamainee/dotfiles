font-family = monospace
font-size = 12

quit-after-last-window-closed = false

working-directory = home
window-inherit-working-directory = false

background-opacity = 0.9
command = /usr/bin/zsh

keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard

foreground = #f0d9b5
background = #0d1520

selection-background = #FF6B00
selection-foreground = #0d1520

cursor-color = #FF9320
cursor-text = #0d1520

palette = 0=#0d1520
palette = 1=#cc3333
palette = 2=#7aab5a
palette = 3=#FFB347
palette = 4=#5ba3c9
palette = 5=#b87aaa
palette = 6=#FF8C42
palette = 7=#c8b89a
palette = 8=#1e2a3a
palette = 9=#ff5555
palette = 10=#98c97a
palette = 11=#FFD080
palette = 12=#80bfdd
palette = 13=#d4a0c8
palette = 14=#FFB060
palette = 15=#f0d9b5
