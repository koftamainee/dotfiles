font=monospace bold 12
background-color=#0a0a0a
text-color=#e8e4da
width=320
height=140

anchor=top-right
margin=8
padding=8

border-size=2
border-color=#c81e2e
border-radius=8

icons=1
max-icon-size=40
icon-path=/usr/share/icons

markup=1
actions=1
history=1
max-history=20

max-visible=5
default-timeout=6000
ignore-timeout=1

group-by=app-name,summary
sort=-time

[urgency=low]
border-color=#3ec9b0
default-timeout=1000

[urgency=normal]
border-color=#c81e2e
default-timeout=2000

[urgency=critical]
border-color=#ff2d3a
default-timeout=0

[mode=dnd]
invisible=1
